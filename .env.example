DB_URL=jdbc:postgresql://127.0.0.1:5432/TrentPlayer?sslmode=disable
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password
# Rotating this invalidates every issued access + refresh token; clients must sign in again.
JWT_SECRET=replace-with-a-random-string-at-least-32-bytes-long
# Folder the API reads audio from. On this PC it is the OneDrive TrentPlayer folder.
MEDIA_ROOT=C:/Users/GIDEON ASUMANG/OneDrive/TrentPlayer-Music

# Where the Expo app finds the backend. Only EXPO_PUBLIC_* keys are inlined into the JS
# bundle, so the secrets above never reach the app. On a physical phone `localhost` is the
# phone itself; use the LAN IP of the machine running Spring Boot instead.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8080
